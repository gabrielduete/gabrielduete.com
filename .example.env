# Create .env file with sentry dsn token
NEXT_PUBLIC_SENTRY_DSN=TOKEN_DSN

# Groq (free tier) — chat model
GROQ_API_KEY=
# Upstash Vector — blog RAG index (hosted embeddings)
UPSTASH_VECTOR_REST_URL=
UPSTASH_VECTOR_REST_TOKEN=
# Upstash Redis — per-IP rate limiting for /api/chat.
# The Vercel Upstash integration injects these as KV_REST_API_URL / KV_REST_API_TOKEN.
# Either name works (KV_* is preferred, UPSTASH_REDIS_REST_* is the fallback).
KV_REST_API_URL=
KV_REST_API_TOKEN=
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=